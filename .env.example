# Copy to .env (never commit .env). All values below are placeholders.

# --- Database (MongoDB, via Prisma 6) ---------------------------------------
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority"

# --- Public site -------------------------------------------------------------
# Used for canonical URLs and Open Graph metadata. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://www.example.com"

# --- Contact form (existing feature) ----------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Image storage ------------------------------------------------------------
# Required in production on serverless hosts (Vercel etc.). Create a free
# Cloudinary account and copy the values from its dashboard.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="replace-me"
# Only for a self-hosted server with a persistent disk and NO Cloudinary:
# ALLOW_LOCAL_UPLOADS="true"

# --- First administrator (read ONLY by `npm run db:seed`) ---------------------
# After seeding you can remove these from .env.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-long-random-password"
ADMIN_NAME="Administrator"
